{
    "settingGroups": {
        "FalconBeat": {
            "description": "FalconBeat",
            "level": 0,
            "settings": [
                "enabled",
                "serverAddr",
                "falconbeatToken",
                "syncOffsetMs"
            ]
        },
        "FalconBeatShow": {
            "description": "Show Info (listener page)",
            "level": 0,
            "settings": [
                "showName",
                "showTagline",
                "showHostedBy",
                "showSchedule",
                "showLocation",
                "showPublicUrl"
            ]
        },
        "FalconBeatAdvanced": {
            "description": "Advanced",
            "level": 1,
            "settings": [
                "nudgeMs",
                "disconnectGraceSec"
            ]
        }
    },
    "settings": {
        "enabled": {
            "name": "enabled",
            "description": "Enabled",
            "tip": "When off, playback events are ignored.",
            "restart": 0,
            "reboot": 0,
            "level": 0,
            "type": "checkbox",
            "checkedValue": "1",
            "uncheckedValue": "0",
            "default": "0"
        },
        "serverAddr": {
            "name": "serverAddr",
            "description": "Server (LAN)",
            "tip": "falconbeat.local or falconbeat.local:9080 — one port carries everything.",
            "restart": 0,
            "reboot": 0,
            "level": 0,
            "type": "text",
            "size": 40,
            "maxlength": 128,
            "default": ""
        },
        "falconbeatToken": {
            "name": "falconbeatToken",
            "description": "Server Token",
            "tip": "FALCONBEAT_TOKEN on the server. Saved under plugindata (0600) — shows blank even when set.",
            "restart": 0,
            "reboot": 0,
            "level": 0,
            "type": "password",
            "onChange": "fbSaveSecret.bind(null, \"falconbeatToken\", this)",
            "size": 40,
            "maxlength": 128,
            "default": ""
        },
        "showName": {
            "name": "showName",
            "description": "Show Name",
            "tip": "Big title on the listener page. Blank = your FPP HostName.",
            "restart": 0,
            "reboot": 0,
            "level": 0,
            "type": "text",
            "size": 40,
            "maxlength": 128,
            "default": ""
        },
        "showTagline": {
            "name": "showTagline",
            "description": "Tagline",
            "tip": "Small line under the show name. Blank = your FPP HostDescription.",
            "restart": 0,
            "reboot": 0,
            "level": 0,
            "type": "text",
            "size": 40,
            "maxlength": 200,
            "default": ""
        },
        "showHostedBy": {
            "name": "showHostedBy",
            "description": "Hosted By",
            "tip": "e.g. \"The Smith Family\" — shown in Show Info.",
            "restart": 0,
            "reboot": 0,
            "level": 0,
            "type": "text",
            "size": 40,
            "maxlength": 128,
            "default": ""
        },
        "showSchedule": {
            "name": "showSchedule",
            "description": "Schedule",
            "tip": "e.g. \"Nightly 6-11pm, Nov 28 - Jan 1\".",
            "restart": 0,
            "reboot": 0,
            "level": 0,
            "type": "text",
            "size": 40,
            "maxlength": 200,
            "default": ""
        },
        "showLocation": {
            "name": "showLocation",
            "description": "Location",
            "tip": "Address or short description of where the show is.",
            "restart": 0,
            "reboot": 0,
            "level": 0,
            "type": "text",
            "size": 40,
            "maxlength": 200,
            "default": ""
        },
        "showPublicUrl": {
            "name": "showPublicUrl",
            "description": "Public Listener URL",
            "tip": "The https URL visitors load (your tunnel/proxy) — used for the signage QR below.",
            "restart": 0,
            "reboot": 0,
            "level": 0,
            "type": "text",
            "size": 40,
            "maxlength": 200,
            "default": ""
        },
        "syncOffsetMs": {
            "name": "syncOffsetMs",
            "description": "Sync Offset",
            "tip": "Adds delay on the listener side to line up with FPP — raise it if the audio runs ahead of the lights, lower it if it trails.",
            "restart": 0,
            "reboot": 0,
            "level": 0,
            "type": "number",
            "min": -1000,
            "max": 3000,
            "step": 10,
            "default": "0",
            "suffix": "ms"
        },
        "nudgeMs": {
            "name": "nudgeMs",
            "description": "Extra Delay",
            "tip": "Added to the computed device delay. 0 = auto.",
            "restart": 0,
            "reboot": 0,
            "level": 1,
            "type": "number",
            "min": -1000,
            "max": 5000,
            "step": 10,
            "default": "0",
            "suffix": "ms"
        },
        "disconnectGraceSec": {
            "name": "disconnectGraceSec",
            "description": "Disconnect grace",
            "tip": "Seconds the admin socket is held after playlist stop.",
            "restart": 0,
            "reboot": 0,
            "level": 1,
            "type": "number",
            "min": 0,
            "max": 600,
            "step": 1,
            "default": "5",
            "suffix": "s"
        }
    }
}
