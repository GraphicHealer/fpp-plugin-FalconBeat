{
    "settingGroups": {
        "FalconBeat": {
            "description": "FalconBeat",
            "level": 0,
            "settings": [
                "enabled",
                "serverAddr",
                "falconbeatToken",
                "syncOffsetMs"
            ]
        },
        "FalconBeatAdvanced": {
            "description": "Advanced",
            "level": 1,
            "settings": [
                "gateMaxSec",
                "preloadSettleMs"
            ]
        },
        "FalconBeatDeveloper": {
            "description": "Developer",
            "level": 3,
            "settings": [
                "nudgeMs",
                "disconnectGraceSec"
            ]
        }
    },
    "settings": {
        "enabled": {
            "name": "enabled",
            "description": "Enabled",
            "tip": "When off, playback events are ignored.",
            "restart": 0,
            "reboot": 0,
            "level": 0,
            "type": "checkbox",
            "checkedValue": "1",
            "uncheckedValue": "0",
            "default": "1"
        },
        "serverAddr": {
            "name": "serverAddr",
            "description": "Server (LAN)",
            "tip": "falconbeat.local or falconbeat.local:9080 — one port carries everything.",
            "restart": 0,
            "reboot": 0,
            "level": 0,
            "type": "text",
            "size": 40,
            "maxlength": 128,
            "default": ""
        },
        "falconbeatToken": {
            "name": "falconbeatToken",
            "description": "Server Token",
            "tip": "FALCONBEAT_TOKEN on the server. Saved under plugindata (0600) — shows blank even when set.",
            "restart": 0,
            "reboot": 0,
            "level": 0,
            "type": "password",
            "onChange": "fbSaveSecret.bind(null, \"falconbeatToken\", this)",
            "size": 40,
            "maxlength": 128,
            "default": ""
        },
        "syncOffsetMs": {
            "name": "syncOffsetMs",
            "description": "Sync Offset",
            "tip": "Raise it if the audio runs ahead of the lights, lower it if the audio trails.",
            "restart": 0,
            "reboot": 0,
            "level": 0,
            "type": "number",
            "min": 0,
            "max": 5000,
            "step": 10,
            "default": "250",
            "suffix": "ms"
        },
        "gateMaxSec": {
            "name": "gateMaxSec",
            "description": "Sync Gate",
            "tip": "Hold each track's start until devices confirm loaded. 0 = off.",
            "restart": 0,
            "reboot": 0,
            "level": 1,
            "type": "number",
            "min": 0,
            "max": 60,
            "step": 1,
            "default": "10",
            "suffix": "s"
        },
        "preloadSettleMs": {
            "name": "preloadSettleMs",
            "description": "Preload Settle",
            "tip": "Wait after a fresh upload before PLAY so devices can download. 0 = off.",
            "restart": 0,
            "reboot": 0,
            "level": 1,
            "type": "number",
            "min": 0,
            "max": 30000,
            "step": 100,
            "default": "2500",
            "suffix": "ms"
        },
        "nudgeMs": {
            "name": "nudgeMs",
            "description": "Extra Delay",
            "tip": "Added to the computed device delay. 0 = auto.",
            "restart": 0,
            "reboot": 0,
            "level": 3,
            "type": "number",
            "min": -1000,
            "max": 5000,
            "step": 10,
            "default": "0",
            "suffix": "ms"
        },
        "disconnectGraceSec": {
            "name": "disconnectGraceSec",
            "description": "Disconnect grace",
            "tip": "Seconds the admin socket is held after playlist stop.",
            "restart": 0,
            "reboot": 0,
            "level": 3,
            "type": "number",
            "min": 0,
            "max": 600,
            "step": 1,
            "default": "5",
            "suffix": "s"
        }
    }
}
